# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Configuration file for LiteIDE
.liteide/

# IDE and editor specific files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Coverage reports
*.cover

# Dependency directories (remove the comment below if you use vendoring)
# vendor/

# Glide dependencies and packages
.glide/
glide.lock

# Godep dependency directories
Godeps/

# Go workspace file
go.work

# Goland IDE files
*.iml
.idea_modules/
__pycache__/

# OS-specific files
.DS_Store
Thumbs.db

# User-specific files
*.local

# Package files
*.tar.gz
*.zip
*.sh

# Build directories
bin/
obj/

# Compiled object files
*.o
*.a

# Coverage files
*.coverprofile

# Configuration files
.env

# Profiling data
*.pprof

# The standalone binary from `make build`. Anchored with a leading slash: an
# unanchored pattern also matches directories at any depth, which hid the
# plugin's cmd/harness-migrate/ source dir.
/harness-migrate

# Isolated HARNESS_CLI_HOME for plugin dev installs (see Taskfile.yml)
plugin/devhome/

# Release artifacts built by plugin/scripts/release-migrate.sh. Already covered
# by the *.tar.gz / *.zip patterns above, but named so the whole directory is
# out of the way, checksums.txt included.
plugin/dist/

# Checked-in tooling that the blanket *.sh ignore above would otherwise hide.
!plugin/scripts/*.sh

# Claude Code local settings
.claude/settings.local.json
